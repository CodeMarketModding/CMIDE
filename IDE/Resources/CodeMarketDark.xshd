<?xml version="1.0"?>
<SyntaxDefinition name="Code Market C#" extensions=".cs" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955"/><Color name="String" foreground="#CE9178"/><Color name="Number" foreground="#B5CEA8"/><Color name="Keyword" foreground="#569CD6"/><Color name="Control" foreground="#C586C0"/><Color name="Type" foreground="#4EC9B0"/>
  <RuleSet>
    <Span color="Comment" begin="//"/><Span color="Comment" multiline="true" begin="/\*" end="\*/"/>
    <Span color="String" begin="@&quot;" end="&quot;"><RuleSet><Span begin="&quot;&quot;" end=""/></RuleSet></Span>
    <Span color="String" begin="&quot;" end="&quot;"><RuleSet><Span begin="\\" end="."/></RuleSet></Span>
    <Span color="String" begin="'" end="'"><RuleSet><Span begin="\\" end="."/></RuleSet></Span>
    <Keywords color="Control"><Word>if</Word><Word>else</Word><Word>while</Word><Word>for</Word><Word>foreach</Word><Word>return</Word><Word>break</Word><Word>continue</Word><Word>switch</Word><Word>case</Word><Word>default</Word><Word>new</Word><Word>try</Word><Word>catch</Word><Word>throw</Word></Keywords>
    <Keywords color="Keyword"><Word>bool</Word><Word>int</Word><Word>double</Word><Word>float</Word><Word>string</Word><Word>char</Word><Word>void</Word><Word>var</Word><Word>true</Word><Word>false</Word><Word>null</Word><Word>public</Word><Word>private</Word><Word>class</Word><Word>static</Word><Word>using</Word></Keywords>
    <Keywords color="Type"><Word>Robot</Word><Word>Store</Word><Word>Order</Word><Word>Product</Word><Word>Direction</Word><Word>Entity</Word><Word>Customer</Word><Word>Shelf</Word><Word>Cell</Word><Word>Season</Word><Word>List</Word><Word>Console</Word></Keywords>
    <Rule color="Number">\b\d+(\.\d+)?\b</Rule>
  </RuleSet>
</SyntaxDefinition>
