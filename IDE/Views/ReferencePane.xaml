<UserControl x:Class="CodeMarket.IDE.Views.ReferencePane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#222A34">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#398DCA" Padding="12,9"><DockPanel><Button x:Name="BackButton" DockPanel.Dock="Right" Content="← Contents" Click="BackClick" Padding="8,3" Visibility="Collapsed"/><TextBlock Text="Reference" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/></DockPanel></Border>
    <Border x:Name="SearchBar" DockPanel.Dock="Top" Background="#1B2430" Padding="10,8"><TextBox x:Name="Search" Background="#33404F" Foreground="#E8EDF2" CaretBrush="White" BorderThickness="0" Padding="8,5" ToolTip="Search unlocked reference entries" TextChanged="SearchChanged"/></Border>
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ContentPanel" Margin="14"/></ScrollViewer>
  </DockPanel>
</UserControl>
